# Constraint enforcement, outcomes checked against PostgreSQL

statement ok
CREATE TABLE customers (id INT PRIMARY KEY, email VARCHAR(50) NOT NULL UNIQUE, age INT NULL CHECK (age >= 18))

statement ok
CREATE TABLE orders (id INT PRIMARY KEY, customer INT NOT NULL REFERENCES customers(id), total INT NOT NULL CHECK (total > 0))

