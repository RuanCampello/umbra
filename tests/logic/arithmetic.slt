query RRR
SELECT POWER(2, 10), POWER(2, 64), POWER(2, -1)
----
1024.000	18446744073709551616.000	0.500

query II
SELECT id, CAST(CASE WHEN id > 100 THEN n ELSE -x END AS INT) FROM measures WHERE id = 2
----
