query I
SELECT -9223372036854775807 - 1
----
-9223372036854775808

query R
SELECT 9223372036854775808 + 1
----
9223372036854775808.000

query R
SELECT 100000000000000000000 / 3
----
33333333333333331968.000

query RR rowsort
SELECT 1.5 % n, -1.5 % n FROM measures WHERE n <> 0
----
0.450	-0.450
0.500	-0.500
1.500	-1.500
1.500	-1.500

statement ok
INSERT INTO measures (id, a, b, x, n) VALUES (6, 1, 1, 0.1, 0.10)

query IR
SELECT id, -1.5 % n FROM measures WHERE id = 6
----
6	0.000

query I
SELECT id FROM measures WHERE id = 6 AND -1.5 % n != 0
----

query IR
SELECT id, COALESCE(-1.5 % n, 1.5) FROM measures WHERE id = 6
----
6	0.000

query I
SELECT id FROM measures WHERE id = 6 AND COALESCE(-1.5 % n, 1.5) != 0
----

query II
SELECT CAST(n + (1.5 / -1) AS BIGINT), CAST(COALESCE(n + -1.5, 0) AS BIGINT) FROM measures WHERE id = 5
----
-1	-1

statement error
SELECT -(-9223372036854775807 - 1)

query I
SELECT -(-9223372036854775807)
----
9223372036854775807

statement error
