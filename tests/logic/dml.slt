# Updates and deletes, results from PostgreSQL

statement ok
CREATE TABLE stock (id INTEGER PRIMARY KEY, item TEXT NOT NULL, quantity INTEGER NOT NULL, price DOUBLE PRECISION NOT NULL)

statement ok
INSERT INTO stock (id, item, quantity, price) VALUES (1, 'bolt', 100, 0.25), (2, 'nut', 250, 0.1), (3, 'gear', 12, 4.5), (4, 'chain', 3, 19.0), (5, 'spring', 40, 1.2)

statement ok
UPDATE stock SET quantity = quantity - 10 WHERE quantity > 50

query II rowsort
SELECT id, quantity FROM stock
----
1	90
2	240
3	12
4	3
5	40

statement ok
UPDATE stock SET price = price * 2, quantity = quantity + 1 WHERE item LIKE '%n%'

query IIR rowsort
SELECT id, quantity, price FROM stock
----
1	90	0.250
2	241	0.200
3	12	4.500
4	4	38.000
5	41	2.400

statement ok
UPDATE stock SET id = id + 10 WHERE id > 3

query I rowsort
SELECT id FROM stock
----
1
14
15
2
3

statement ok
DELETE FROM stock WHERE price > 5 OR quantity < 20

query T rowsort
SELECT item FROM stock
----
bolt
nut
spring

query IT
UPDATE stock SET quantity = 0 WHERE item = 'bolt' RETURNING id, item
----
1	bolt

query I
SELECT COUNT(*) FROM stock WHERE quantity = 0
----
1

statement ok
DELETE FROM stock

query I
SELECT COUNT(*) FROM stock
----
0
