# Index access paths must return what a full scan returns, results from PostgreSQL

statement ok
CREATE TABLE events (id INTEGER PRIMARY KEY, code VARCHAR(10) NOT NULL UNIQUE, severity INTEGER NOT NULL, origin TEXT NOT NULL)

statement ok
CREATE INDEX events_severity ON events(severity)

statement ok
INSERT INTO events (id, code, severity, origin) VALUES (1, 'e01', 3, 'api'), (2, 'e02', 1, 'db'), (3, 'e03', 5, 'api'), (4, 'e04', 3, 'web'), (5, 'e05', 2, 'db'), (6, 'e06', 5, 'web'), (7, 'e07', 4, 'api'), (8, 'e08', 1, 'web'), (9, 'e09', 2, 'api'), (10, 'e10', 4, 'db')

query T
SELECT code FROM events WHERE code >= 'e04' ORDER BY code LIMIT 3
----
e04
e05
e06

query T
SELECT code FROM events WHERE code >= 'e04' ORDER BY code DESC LIMIT 3
----
e10
e09
e08

query T
SELECT code FROM events WHERE code > 'e02' AND code <= 'e07' ORDER BY code DESC
----
e07
e06
e05
e04
e03

query I
SELECT id FROM events WHERE id < 6 ORDER BY id DESC LIMIT 2 OFFSET 1
----
4
3

query I
SELECT id FROM events WHERE id IN (9, 2, 7, 4) ORDER BY id DESC
----
9
7
4
2

query I
SELECT id FROM events WHERE id IN (9, 2, 7, 4) ORDER BY id LIMIT 2
----
2
4

query IT
SELECT id, origin FROM events WHERE code >= 'e03' AND origin = 'api' ORDER BY code
----
3	api
7	api
9	api

query I rowsort
SELECT id FROM events WHERE origin = 'web' AND severity = 5
----
6

query I rowsort
SELECT id FROM events WHERE severity >= 4 AND origin != 'db'
----
3
6
7

query II
SELECT severity, id FROM events WHERE severity > 1 ORDER BY severity DESC, id LIMIT 4
----
5	3
5	6
4	7
4	10

query I
SELECT id FROM events WHERE severity = 3 ORDER BY severity, id DESC
----
4
1

query T
SELECT code FROM events WHERE code < 'e00' ORDER BY code
----

query I
SELECT id FROM events WHERE id >= 3 AND id <= 3 ORDER BY id DESC
----
3

statement ok
UPDATE events SET code = 'e00' WHERE id = 10

query T
SELECT code FROM events WHERE code <= 'e02' ORDER BY code
----
e00
e01
e02

statement ok
DELETE FROM events WHERE severity = 1

query I
SELECT id FROM events WHERE severity <= 2 ORDER BY severity DESC, id
----
5
9

# Composite indexes: equalities on leading columns, then a range or a point set on the next

statement ok
CREATE TABLE orders (id INTEGER PRIMARY KEY, w INTEGER NOT NULL, d INTEGER NULL, o INTEGER NOT NULL, amount INTEGER NOT NULL)

statement ok
CREATE UNIQUE INDEX orders_key ON orders (w, d, o)

statement ok
INSERT INTO orders (id, w, d, o, amount) VALUES (1, 1, 1, 1, 10), (2, 1, 1, 2, 20), (3, 1, 2, 1, 30), (4, 1, 2, 2, 40), (5, 1, 2, 3, 50), (6, 1, 2, 4, 60), (7, 1, 3, 1, 70), (8, 2, 1, 1, 80), (9, 2, 2, 5, 90), (10, 3, NULL, 1, 100), (11, 3, NULL, 1, 110)

statement error
INSERT INTO orders (id, w, d, o, amount) VALUES (12, 1, 2, 3, 0)

query I
SELECT amount FROM orders WHERE w = 1 AND d = 2 AND o = 3
----
50

query I
SELECT amount FROM orders WHERE w = 1 AND d = 2 ORDER BY amount
----
30
40
50
60

query II
SELECT o, amount FROM orders WHERE w = 1 AND d = 2 AND o > 1 ORDER BY o DESC LIMIT 2
----
4	60
3	50

query II
SELECT o, amount FROM orders WHERE d = 2 AND w = 1 AND o >= 2 AND o < 4 ORDER BY o
----
2	40
3	50

query I rowsort
SELECT amount FROM orders WHERE w = 1 AND d IN (1, 3)
----
10
20
70

query I rowsort
SELECT amount FROM orders WHERE w = 2
----
80
90

query I rowsort
SELECT amount FROM orders WHERE w = 1 AND o = 2
----
20
40

query I rowsort
SELECT amount FROM orders WHERE w = 3
----
100
110

query III
SELECT w, d, o FROM orders ORDER BY w, d, o LIMIT 4
----
1	1	1
1	1	2
1	2	1
1	2	2

query II
SELECT d, o FROM orders WHERE w = 1 ORDER BY d DESC, o DESC LIMIT 3
----
3	1
2	4
2	3

query II
SELECT d, o FROM orders WHERE w = 1 AND d >= 2 ORDER BY d, o
----
2	1
2	2
2	3
2	4
3	1

statement ok
UPDATE orders SET o = 9 WHERE id = 4

query I
SELECT o FROM orders WHERE w = 1 AND d = 2 ORDER BY o
----
1
3
4
9

statement ok
DELETE FROM orders WHERE w = 1 AND d = 2 AND o < 4

query I rowsort
SELECT amount FROM orders WHERE w = 1 AND d = 2
----
40
60

statement ok
INSERT INTO orders (id, w, d, o, amount) VALUES (12, 1, 2, 1, 120)

query II
SELECT o, amount FROM orders WHERE w = 1 AND d = 2 ORDER BY o
----
1	120
4	60
9	40
