# HAVING and DISTINCT, results from PostgreSQL

statement ok
CREATE TABLE orders (id INT PRIMARY KEY, customer TEXT NOT NULL, region TEXT NOT NULL, total INT NOT NULL, discount INT NULL)

statement ok
INSERT INTO orders (id, customer, region, total, discount) VALUES (1, 'ada', 'north', 120, NULL), (2, 'ada', 'north', 80, 5), (3, 'grace', 'south', 300, NULL), (4, 'alan', 'south', 40, 10), (5, 'alan', 'south', 40, NULL), (6, 'edsger', 'east', 500, 50), (7, 'grace', 'south', 60, NULL), (8, 'barbara', 'north', 40, NULL)

query TI rowsort
SELECT customer, SUM(total) FROM orders GROUP BY customer HAVING SUM(total) > 100
----
ada	200
edsger	500
grace	360

query TI rowsort
SELECT region, COUNT(*) FROM orders GROUP BY region HAVING COUNT(*) >= 3
----
north	3
south	4

query TI rowsort
SELECT region, MAX(total) FROM orders GROUP BY region HAVING MIN(total) < 50 AND region != 'east'
----
north	120
south	300

query TI
SELECT customer, SUM(total) AS spent FROM orders GROUP BY customer HAVING COUNT(discount) = 0 ORDER BY spent DESC
----
grace	360
barbara	40

query I
SELECT COUNT(*) FROM orders HAVING COUNT(*) > 100
----

query I
SELECT SUM(total) FROM orders HAVING SUM(total) > 100
----
1180

query TI
SELECT region, SUM(total) FROM orders GROUP BY region HAVING SUM(total) > 0 ORDER BY region LIMIT 2
----
east	500
north	240

query T rowsort
SELECT DISTINCT region FROM orders
----
east
north
south

query TT
SELECT DISTINCT region, customer FROM orders ORDER BY region, customer
----
east	edsger
north	ada
north	barbara
south	alan
south	grace

query I
SELECT DISTINCT total FROM orders ORDER BY total DESC LIMIT 3
----
500
300
120

query I rowsort
SELECT DISTINCT discount FROM orders
----
10
5
50
NULL

query T
SELECT DISTINCT customer FROM orders WHERE total < 100 ORDER BY customer
----
ada
alan
barbara
grace

query I rowsort
SELECT DISTINCT COUNT(*) FROM orders GROUP BY region
----
1
3
4

statement error
SELECT DISTINCT region FROM orders ORDER BY total

statement error
SELECT region FROM orders GROUP BY region HAVING SUM(total)

query II
SELECT COUNT(DISTINCT region), COUNT(DISTINCT discount) FROM orders
----
3	3

query TII rowsort
SELECT region, COUNT(DISTINCT customer), COUNT(*) FROM orders GROUP BY region
----
east	1	1
north	2	3
south	2	4

query TI rowsort
SELECT region, COUNT(DISTINCT total) FROM orders GROUP BY region HAVING COUNT(DISTINCT customer) > 1
----
north	3
south	3

query I
SELECT COUNT(DISTINCT total) FROM orders WHERE total > 10000
----
0
