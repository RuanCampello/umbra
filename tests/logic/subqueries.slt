# Uncorrelated subqueries, results from PostgreSQL

statement ok
CREATE TABLE authors (id INT PRIMARY KEY, name TEXT NOT NULL, country TEXT NULL)

statement ok
CREATE TABLE books (id INT PRIMARY KEY, author INT NOT NULL, title TEXT NOT NULL, pages INT NOT NULL)

statement ok
INSERT INTO authors (id, name, country) VALUES (1, 'Le Guin', 'US'), (2, 'Lem', 'PL'), (3, 'Borges', 'AR'), (4, 'Calvino', NULL)

statement ok
INSERT INTO books (id, author, title, pages) VALUES (1, 1, 'The Dispossessed', 387), (2, 1, 'Earthsea', 183), (3, 2, 'Solaris', 204), (4, 3, 'Ficciones', 174), (5, 2, 'The Cyberiad', 295)

query T rowsort
SELECT name FROM authors WHERE id IN (SELECT author FROM books WHERE pages > 200)
----
Le Guin
Lem

query T rowsort
SELECT name FROM authors WHERE id NOT IN (SELECT author FROM books)
----
Calvino

query T rowsort
SELECT title FROM books WHERE pages > (SELECT AVG(pages) FROM books)
----
The Cyberiad
The Dispossessed

query TI
SELECT title, pages - (SELECT MIN(pages) FROM books) FROM books ORDER BY id
----
The Dispossessed	213
Earthsea	9
Solaris	30
Ficciones	0
The Cyberiad	121

query T rowsort
SELECT name FROM authors WHERE EXISTS (SELECT id FROM books WHERE pages > 300)
----
Borges
Calvino
Le Guin
Lem

query T rowsort
SELECT name FROM authors WHERE NOT EXISTS (SELECT id FROM books WHERE pages > 1000)
----
Borges
Calvino
Le Guin
Lem

query I
SELECT COUNT(*) FROM books WHERE author IN (SELECT id FROM authors WHERE country IN (SELECT country FROM authors WHERE name = 'Lem'))
----
2

query T rowsort
SELECT name FROM authors WHERE id IN (SELECT author FROM books WHERE pages > 1000)
----

query T rowsort
SELECT name FROM authors WHERE country NOT IN (SELECT country FROM authors WHERE id > 2)
----

query I
SELECT (SELECT COUNT(*) FROM books) FROM authors WHERE id = 1
----
5

query I
SELECT (SELECT pages FROM books WHERE id = 99) IS NULL FROM authors WHERE id = 1
----
1

statement ok
UPDATE books SET pages = pages + 1 WHERE author IN (SELECT id FROM authors WHERE country = 'PL')

statement ok
DELETE FROM books WHERE pages < (SELECT AVG(pages) FROM books) - 50

query TI rowsort
SELECT title, pages FROM books
----
Solaris	205
The Cyberiad	296
The Dispossessed	387

statement error
SELECT name FROM authors WHERE id = (SELECT author FROM books)

statement error
SELECT name FROM authors WHERE id IN (SELECT id, name FROM authors)

query T rowsort
SELECT name FROM authors WHERE EXISTS (SELECT id FROM books WHERE books.author = authors.id)
----
Le Guin
Lem

# a correlation other than one equality is not supported yet: an error, never a wrong answer
skipif postgresql
statement error
SELECT name FROM authors WHERE EXISTS (SELECT id FROM books WHERE books.author = authors.id AND books.pages > authors.id * 100)

skipif postgresql
statement error
SELECT name, (SELECT MAX(pages) FROM books WHERE books.author = authors.id) FROM authors

# Correlated EXISTS and NOT EXISTS over one equality, NULLs on either side

statement ok
CREATE TABLE parent (id INT PRIMARY KEY, code INT NULL, name TEXT NOT NULL)

statement ok
CREATE TABLE child (id INT PRIMARY KEY, parent_code INT NULL, kind TEXT NOT NULL, weight INT NOT NULL)

statement ok
INSERT INTO parent (id, code, name) VALUES (1, 10, 'a'), (2, 20, 'b'), (3, NULL, 'c'), (4, 40, 'd'), (5, 50, 'e')

statement ok
INSERT INTO child (id, parent_code, kind, weight) VALUES (1, 10, 'x', 5), (2, 10, 'y', 7), (3, 20, 'y', 1), (4, NULL, 'x', 9), (5, 40, 'x', 2)

query T rowsort
SELECT name FROM parent p WHERE EXISTS (SELECT 1 FROM child c WHERE c.parent_code = p.code)
----
a
b
d

query T rowsort
SELECT name FROM parent p WHERE NOT EXISTS (SELECT 1 FROM child c WHERE c.parent_code = p.code)
----
c
e

query T rowsort
SELECT name FROM parent p WHERE EXISTS (SELECT 1 FROM child c WHERE p.code = c.parent_code AND c.kind = 'y' AND c.weight > 2)
----
a

query T rowsort
SELECT name FROM parent p WHERE NOT EXISTS (SELECT 1 FROM child c WHERE c.parent_code = p.code AND c.kind = 'x') AND p.id < 5
----
b
c

query TI rowsort
SELECT p.name, p.id FROM parent p WHERE EXISTS (SELECT * FROM child c JOIN parent q ON q.code = c.parent_code WHERE c.parent_code = p.code AND q.id <> 2)
----
a	1
d	4

statement ok
DELETE FROM parent WHERE NOT EXISTS (SELECT 1 FROM child c WHERE c.parent_code = parent.code)

query T rowsort
SELECT name FROM parent
----
a
b
d

query T rowsort
SELECT name FROM parent p WHERE EXISTS (SELECT 1 FROM child p WHERE p.weight > 6)
----
a
b
d
