# CAST, results from PostgreSQL

statement ok
CREATE TABLE prices (id INT PRIMARY KEY, amount DOUBLE PRECISION NOT NULL, label TEXT NOT NULL, exact NUMERIC(10, 3) NULL)

statement ok
INSERT INTO prices (id, amount, label, exact) VALUES (1, 2.5, '42', 1.255), (2, 3.5, '7', -1.255), (3, -2.5, '-3', NULL), (4, 10.75, '0', 2.5)

query II rowsort
SELECT id, CAST(amount AS INT) FROM prices
----
1	2
2	4
3	-2
4	11

query IR rowsort
SELECT id, CAST(exact AS NUMERIC(10, 2)) FROM prices
----
1	1.260
2	-1.260
3	NULL
4	2.500

query II rowsort
SELECT id, CAST(exact AS INT) FROM prices
----
1	1
2	-1
3	NULL
4	3

query II rowsort
SELECT id, CAST(label AS INT) + 1 FROM prices
----
1	43
2	8
3	-2
4	1

query IT rowsort
SELECT id, CAST(id AS TEXT) FROM prices
----
1	1
2	2
3	3
4	4

query IR rowsort
SELECT id, CAST(id AS DOUBLE PRECISION) / 4 FROM prices
----
1	0.250
2	0.500
3	0.750
4	1.000

query IT rowsort
SELECT id, CAST(label AS VARCHAR(1)) FROM prices
----
1	4
2	7
3	-
4	0

query I rowsort
SELECT id FROM prices WHERE CAST(label AS INT) > 5
----
1
2

query I
SELECT COUNT(*) FROM prices WHERE CAST(exact AS INT) IS NULL
----
1

query T
SELECT CAST(CAST('2024-02-29' AS DATE) AS TEXT) FROM prices WHERE id = 1
----
2024-02-29

statement ok
INSERT INTO prices (id, amount, label, exact) VALUES (5, 1, 'x', 0)

statement error
SELECT CAST(label AS INT) FROM prices

statement error
SELECT CAST(100000 AS SMALLINT) FROM prices

statement error
SELECT CAST(10000000000000000000.0 AS BIGINT)

statement error
SELECT CAST(CAST(10000000000000000000 AS DOUBLE PRECISION) AS BIGINT)

statement error
SELECT CAST(-10000000000000000000.5 AS BIGINT)

query I
SELECT CAST(9000000000000000000.0 AS BIGINT)
----
9000000000000000000
